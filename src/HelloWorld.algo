Utiliser les constantes de Constantes
Algo HelloWorld {
  fonction principale {
    // Creation de la fenetre
    Creer une fenetre de titre HELLO_WORLD
    Mettre la dimension a 600, 200
    Configurer la fenetre sur 'exitOnClose'
    // Creation du label de texte
    Creer un label avec du texte aligne a gauche et contenant le texte HELLO_WORLD
    Creer la couleur bleu
    Mettre la couleur bleu sur le label
    // Couleur de fond
    Creer la couleur vert pour le fond
    Mettre la couleur vert sur le fond de la fenetre
    // Finalisation
    Ajouter le label sur la fenetre
    Afficher la fenetre
  }
}
